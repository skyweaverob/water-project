# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_SYNTHESIS=claude-opus-4-7
CLAUDE_MODEL_EMBED=voyage-3

# Voyage (embeddings for RAG)
VOYAGE_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procurement

# Redis (Arq jobs)
REDIS_URL=redis://localhost:6379/0

# Clerk
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated list of allowed CORS origins for the FastAPI service.
CORS_ORIGINS=http://localhost:3000

# Demo tenant id — set this on the web service after running app/scripts/seed_demo.py.
# The web app passes this as X-Tenant-Id on every API call.
NEXT_PUBLIC_DEMO_TENANT_ID=

# Search API — powers live disruption signals (Risk Monitor) AND live price discovery (Bid Evaluator).
# Provider options: brave | tavily | exa | serpapi
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# Intratec Primary Commodity Prices — best low-cost commercial source ($299-699/yr).
# Modes:
#   off — disabled (default). Platform falls back to FRED + USGS + search agent.
#   api — REST API. Requires the $699/yr Advanced tier. Set INTRATEC_API_KEY.
#   csv — parse Intratec CSV exports. Requires Starter/Pro and set INTRATEC_CSV_DIR.
INTRATEC_MODE=off
INTRATEC_API_KEY=
INTRATEC_API_URL=
INTRATEC_CSV_DIR=

# EIA Open Data API — free with a key from https://www.eia.gov/opendata/.
# Used for daily Henry Hub gas, WTI crude, and weekly refinery utilization, which drive
# ammonia / sulfur / chloramine pricing more than chemical-specific indices do.
EIA_API_KEY=

# businessanalytiq.com — free public chemical price index pages.
# Opt-in scraper (off | on). Covers caustic, chlorine, sulfuric, ammonia, ferric chloride,
# H2O2, phosphoric, HCl, soda ash, KOH, and a few others Intratec doesn't.
BUSINESSANALYTIQ_MODE=off

# Ingestion corpus location (absolute path on dev machine; on Railway use mounted volume)
EPA_CORPUS_DIR=./corpus
