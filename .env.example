# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_SYNTHESIS=claude-opus-4-7
CLAUDE_MODEL_EMBED=voyage-3

# Voyage (embeddings for RAG)
VOYAGE_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procurement

# Redis (Arq jobs)
REDIS_URL=redis://localhost:6379/0

# Clerk
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated list of allowed CORS origins for the FastAPI service.
CORS_ORIGINS=http://localhost:3000

# Demo tenant id — set this on the web service after running app/scripts/seed_demo.py.
# The web app passes this as X-Tenant-Id on every API call.
NEXT_PUBLIC_DEMO_TENANT_ID=

# Search API — powers live disruption signals (Risk Monitor) AND live price discovery (Bid Evaluator).
# Provider options: brave | tavily | exa | serpapi
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# Ingestion corpus location (absolute path on dev machine; on Railway use mounted volume)
EPA_CORPUS_DIR=./corpus
