# =============================================================================
# REQUIRED — the platform will not start (or core features will fail) without:
# =============================================================================

# Postgres with pgvector. Use Neon (free, https://neon.tech) — paste their connection
# string here, no extra setup. Or Supabase. Or Railway with the pgvector/pgvector image.
DATABASE_URL=postgresql://user:pass@host:5432/procurement

# Anthropic — drives extraction, RAG synthesis, bid extraction, all four agents.
ANTHROPIC_API_KEY=sk-ant-...

# Search API — drives live disruption signals AND price discovery.
# Provider: brave | tavily | exa | serpapi
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# =============================================================================
# RECOMMENDED — turn on free upgrades that meaningfully improve the platform:
# =============================================================================

# Voyage embeddings — needed for the Knowledge Q&A's pgvector RAG. Free tier covers
# this scale. https://www.voyageai.com/
VOYAGE_API_KEY=

# EIA Open Data API — daily Henry Hub gas, WTI, refinery utilization for the Risk
# Monitor. Free with key from https://www.eia.gov/opendata/
EIA_API_KEY=

# businessanalytiq.com free public chemical price index scraper (off | on).
# Adds price coverage for ferric chloride, alum, and several others Intratec misses.
BUSINESSANALYTIQ_MODE=off

# =============================================================================
# OPTIONAL — only set if/when you opt in:
# =============================================================================

# Web app — for browser-side calls. Set to your deployed API URL. NEXT_PUBLIC_*
# vars must be passed as Docker BUILD ARGS (not runtime env) for the web service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Intratec ($299-699/yr commercial price source). Modes: off | api | csv
INTRATEC_MODE=off
INTRATEC_API_KEY=
INTRATEC_CSV_DIR=

# Clerk (auth, when you wire it up)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe (billing, when you wire it up)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Model overrides — defaults are sensible
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_SYNTHESIS=claude-opus-4-7
CLAUDE_MODEL_EMBED=voyage-3

# CORS — usually unnecessary; the API already accepts *.up.railway.app, *.vercel.app,
# *.onrender.com, *.fly.dev via regex.
CORS_ORIGINS=

# EPA corpus location for the ingestion runner.
EPA_CORPUS_DIR=./
